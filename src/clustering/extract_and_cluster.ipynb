    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"import hdbscan\\n\",\n",
    "    \"from sklearn.metrics import silhouette_score, adjusted_rand_score\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from sklearn.cluster import KMeans\\n\",\n",
    "    \"from sklearn.metrics import normalized_mutual_info_score, adjusted_rand_score\\n\",\n",
    "    \"from sklearn.decomposition import PCA\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"PROJECT_ROOT = os.path.abspath(os.path.join(os.getcwd(), \\\"..\\\", \\\"..\\\"))\\n\",\n",
    "    \"sys.path.insert(0, PROJECT_ROOT)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"from src.data.load_cifar100 import get_cifar100_loaders, create_and_load_subset\\n\",\n",
    "    \"from src.models.autoencoder import Autoencoder\\n\",\n",
    "    \"from src.data.load_cifar10 import get_cifar10_loaders\\n\",\n",
    "    \"from src.models.cmae import CMAE\\n\",\n",
    "    \"from src.models.masked_autoencoder import MAE\\n\",\n",
    "    \"from sklearn.manifold import TSNE\\n\",\n",
    "    \"import torch.nn.functional as F\\n\",\n",
    "    \"from sklearn.preprocessing import normalize\"\n",
    "   ],\n",
