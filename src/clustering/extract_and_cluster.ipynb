    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"#  Wizualizacja przykładów z klastrów\",\n",
    "   \"id\": \"c14b51199c97c06a\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.819197Z\",\n",
    "     \"start_time\": \"2026-01-18T18:32:57.804292Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def visualize_cluster_samples(cluster_ids, test_loader, cluster_id=0, n_samples=25):\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    all_images = []\\n\",\n",
    "    \"    for images, _ in test_loader:\\n\",\n",
    "    \"        all_images.append(images)\\n\",\n",
    "    \"    all_images = torch.cat(all_images, dim=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # znajdywanie obrazów z danego klastra\\n\",\n",
    "    \"    mask = cluster_ids == cluster_id\\n\",\n",
    "    \"    cluster_images = all_images[mask][:n_samples]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(5, 5, figsize=(10, 10))\\n\",\n",
    "    \"    for idx, ax in enumerate(axes.flat):\\n\",\n",
    "    \"        if idx < len(cluster_images):\\n\",\n",
    "    \"            img = cluster_images[idx].permute(1, 2, 0).numpy()\\n\",\n",
    "    \"            ax.imshow(img)\\n\",\n",
    "    \"        ax.axis('off')\\n\",\n",
    "    \"    plt.suptitle(f'Przykładowe obrazy z klastra {cluster_id}')\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\"\n",
    "   ],\n",
    "   \"id\": \"4ae7fef77f851828\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Czystość klastrów -- sprawdzenie, jaki % stanowi najczęstsza klasa w danym klastrze\",\n",
    "   \"id\": \"6c2953537930881a\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.865835Z\",\n",
    "     \"start_time\": \"2026-01-18T18:32:57.851256Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def cluster_purity(cluster_ids, labels):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n_clusters = len(np.unique(cluster_ids))\\n\",\n",
    "    \"    purities = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for cluster_id in range(n_clusters):\\n\",\n",
    "    \"        mask = cluster_ids == cluster_id\\n\",\n",
    "    \"        cluster_labels = labels[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(cluster_labels) > 0:\\n\",\n",
    "    \"            # Najczęstsza klasa w tym klastrze\\n\",\n",
    "    \"            most_common = np.bincount(cluster_labels).max()\\n\",\n",
    "    \"            purity = most_common / len(cluster_labels)\\n\",\n",
    "    \"            purities.append(purity)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    avg_purity = np.mean(purities)\\n\",\n",
    "    \"    print(f\\\"Średnia czystość klastrów: {avg_purity:.4f}\\\")\\n\",\n",
    "    \"    return avg_purity\"\n",
    "   ],\n",
    "   \"id\": \"48668c256e205916\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 9\n",
