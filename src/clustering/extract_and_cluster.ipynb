    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Sprawdzenie składu klastrów\",\n",
    "   \"id\": \"778d097515fe373c\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.777728Z\",\n",
    "     \"start_time\": \"2026-01-18T18:32:57.764606Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def analyze_cluster_composition(cluster_ids, labels, n_clusters=100):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Pokazuje, które klasy CIFAR są w których klastrach\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for cluster_id in range(min(10, n_clusters)):  # pokaż pierwsze 10\\n\",\n",
    "    \"        mask = cluster_ids == cluster_id\\n\",\n",
    "    \"        cluster_labels = labels[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        print(f\\\"Klaster {cluster_id} (rozmiar: {len(cluster_labels)}):\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        unique, counts = np.unique(cluster_labels, return_counts=True)\\n\",\n",
    "    \"        sorted_indices = np.argsort(-counts)[:5]  # top 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for idx in sorted_indices:\\n\",\n",
