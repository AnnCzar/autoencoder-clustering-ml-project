    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"2bfc642343fc1f24\",\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"raw\",\n",
    "   \"source\": [\n",
    "    \"# Load pretrained model\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.559681Z\",\n",
    "     \"start_time\": \"2026-01-18T18:32:57.540850Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def load_trained_model(model_path, model_type='autoencoder'):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Wczytanie wytrenowanego modelu\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        model_path: Ścieżka do pliku .pt\\n\",\n",
    "    \"         model_type: \\\"autoencoder', 'cmae' lub 'mae'\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        model, checkpoint (słownik z metadanymi)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    device = torch.device(\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not os.path.exists(model_path):\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Nie znaleziono pliku: {model_path}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # wczytanie checkpointa\\n\",\n",
    "    \"    checkpoint = torch.load(model_path, map_location=device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ładowanie modelu\\n\",\n",
    "    \"    latent_dim = checkpoint.get('latent_dim', 256)  # domyślnie 256\\n\",\n",
    "    \"    if model_type.lower() == 'cmae':\\n\",\n",
    "    \"        model = CMAE(latent_dim=latent_dim).to(device)\\n\",\n",
    "    \"    elif model_type.lower() == 'mae':\\n\",\n",
    "    \"        model = MAE(latent_dim=latent_dim).to(device)\\n\",\n",
    "    \"    elif model_type.lower() == 'autoencoder':\\n\",\n",
    "    \"        model = Autoencoder(latent_dim=latent_dim).to(device)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        raise ValueError(\\\"model_type musi być: 'cmae', 'mae' lub 'autoencoder'\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ładowanie wag\\n\",\n",
    "    \"    model.load_state_dict(checkpoint['model_state_dict'])\\n\",\n",
    "    \"    model.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Model załadowany\\\")\\n\",\n",
    "    \"    print(f\\\"Epoka: {checkpoint['epoch']}\\\")\\n\",\n",
    "    \"    print(f\\\"Train Loss: {checkpoint['train_loss']:.6f}\\\")\\n\",\n",
    "    \"    print(f\\\"Val Loss: {checkpoint['val_loss']:.6f}\\\")\\n\",\n",
    "    \"    print(f\\\"Latent Dim: {latent_dim}\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return model, checkpoint\"\n",
    "   ],\n",
    "   \"id\": \"59563491f1c18946\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Ekstrakcja cech\",\n",
    "   \"id\": \"53c2eb92fcd4c664\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.635298Z\",\n",
    "     \"start_time\": \"2026-01-18T18:32:57.611125Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def extract_features(model, dataloader):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Wyciąga wektory cech z encodera\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        model: Autoencoder, MAE lub CMAE\\n\",\n",
    "    \"        dataloader: DataLoader z danymi\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        features: numpy array [N, latent_dim]\\n\",\n",
    "    \"        labels: numpy array [N]\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    device = torch.device(\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\\n\",\n",
    "    \"    model.to(device)\\n\",\n",
    "    \"    model.eval()\\n\",\n",
    "    \"    all_features = []\\n\",\n",
    "    \"    all_labels = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        for batch_idx, (images, labels) in enumerate(dataloader):\\n\",\n",
    "    \"            images = images.to(device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if hasattr(model, 'online_encoder'):\\n\",\n",
    "    \"                # CMAE\\n\",\n",
    "    \"                features = model.online_encoder(images)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            elif hasattr(model, 'encoder'):\\n\",\n",
    "    \"                # MAE oraz Autoencoder (oba mają self.encoder)\\n\",\n",
    "    \"                features = model.encoder(images)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                raise AttributeError(\\\"Model nie ma atrybutu 'encoder' ani 'online_encoder'\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # flattenujemy cechy -- [B, D, 1, 1] -> [B, D]\\n\",\n",
    "    \"            if len(features.size()) > 2:\\n\",\n",
    "    \"                features = features.view(features.size(0), -1)\\n\",\n",
    "    \"            # dostajemy tylko cechy\\n\",\n",
    "    \"            # features = model.encode(images)  # [batch_size, latent_dim]\\n\",\n",
    "    \"            if batch_idx == 0:  # sprawdzenie\\n\",\n",
    "    \"                print(f\\\"Features: {features.size()}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_features.append(features.cpu().numpy())\\n\",\n",
    "    \"            all_labels.append(labels.numpy())\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    features = np.concatenate(all_features, axis=0)\\n\",\n",
    "    \"    labels = np.concatenate(all_labels, axis=0) # do ocenienia klasteryzacji\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Wyciągnięto cechy: {features.shape}\\\")\\n\",\n",
    "    \"    # print(f\\\"Klasy {labels[:5]}\\\") #sprawdzenie\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return features, labels\"\n",
    "   ],\n",
    "   \"id\": \"cdfe194aa80cbcf0\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Klasteryzacja\",\n",
    "   \"id\": \"59f9a92c35bf622f\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.695735Z\",\n",
    "     \"start_time\": \"2026-01-18T18:32:57.673769Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def clustering(features, labels, n_clusters=10, pca_dim=50):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Klasteryzacja używając K-means i HDBSCAN\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        features: numpy array [N, latent_dim]\\n\",\n",
    "    \"        labels: numpy array [N] - prawdziwe etykiety\\n\",\n",
    "    \"        n_clusters: liczba klastrów dla K-means\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        cluster_ids: numpy array [N] - przypisanie do klastrów (K-means)\\n\",\n",
    "    \"        kmeans: obiekt KMeans\\n\",\n",
    "    \"        metrics: słownik z metrykami K-means\\n\",\n",
    "    \"        metrics_hdb: słownik z metrykami HDBSCAN\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # normalizacja wektora cech\\n\",\n",
    "    \"    features_normalized = normalize(features,norm='l2')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # zmniejszenie wymiarowości cech do 50 z 256\\n\",\n",
    "    \"    if features_normalized.shape[1] > pca_dim:\\n\",\n",
    "    \"        pca = PCA(n_components=pca_dim, random_state=42)\\n\",\n",
    "    \"        features_reduced = pca.fit_transform(features_normalized)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        features_reduced = features_normalized\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # # HDBSCAN\\n\",\n",
    "    \"    # clusterer = hdbscan.HDBSCAN(\\n\",\n",
    "    \"    #     min_cluster_size=n_clusters,\\n\",\n",
    "    \"    #     min_samples=5,\\n\",\n",
    "    \"    #     cluster_selection_method='eom',\\n\",\n",
    "    \"    #     allow_single_cluster=True,\\n\",\n",
    "    \"    #     metric='euclidean',\\n\",\n",
    "    \"    #     algorithm='best',\\n\",\n",
    "    \"    #     leaf_size=30\\n\",\n",
    "    \"    # )\\n\",\n",
    "    \"    # cluster_ids_hdb = clusterer.fit_predict(features_reduced)\\n\",\n",
    "    \"    #\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # K-means\\n\",\n",
    "    \"    kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10, verbose=0)\\n\",\n",
    "    \"    cluster_ids = kmeans.fit_predict(features_reduced)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Metryki K-means\\n\",\n",
    "    \"    nmi = normalized_mutual_info_score(labels, cluster_ids)\\n\",\n",
    "    \"    ari = adjusted_rand_score(labels, cluster_ids)\\n\",\n",
    "    \"    silhouette = silhouette_score(features, cluster_ids)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    metrics = {\\n\",\n",
    "    \"        'nmi': nmi,\\n\",\n",
    "    \"        'ari': ari,\\n\",\n",
    "    \"        'silhouette': silhouette,\\n\",\n",
    "    \"        'n_clusters': n_clusters,\\n\",\n",
    "    \"        'inertia': kmeans.inertia_\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    print(\\\"=== K-means ===\\\")\\n\",\n",
    "    \"    print(f\\\"NMI (Normalized Mutual Information): {nmi:.4f}\\\")\\n\",\n",
    "    \"    print(f\\\"ARI (Adjusted Rand Index): {ari:.4f}\\\")\\n\",\n",
    "    \"    print(f\\\"Silhouette: {silhouette:.4f}\\\")\\n\",\n",
    "    \"    print(f\\\"Inertia: {kmeans.inertia_:.2f}\\\\n\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # # Metryki HDBSCAN\\n\",\n",
    "    \"    # nmi_hdb = normalized_mutual_info_score(labels, cluster_ids_hdb)\\n\",\n",
    "    \"    # ari_hdb = adjusted_rand_score(labels, cluster_ids_hdb)\\n\",\n",
    "    \"    # n_clusters_hdb = len(set(cluster_ids_hdb)) - (1 if -1 in cluster_ids_hdb else 0)\\n\",\n",
    "    \"    # n_noise = list(cluster_ids_hdb).count(-1)\\n\",\n",
    "    \"    # \\n\",\n",
    "    \"    # metrics_hdb = {\\n\",\n",
    "    \"    #     'nmi': nmi_hdb,\\n\",\n",
    "    \"    #     'ari': ari_hdb,\\n\",\n",
    "    \"    #     'n_clusters': n_clusters_hdb,\\n\",\n",
    "    \"    #     'n_noise': n_noise\\n\",\n",
    "    \"    # }\\n\",\n",
    "    \"    # \\n\",\n",
    "    \"    # print(f\\\"NMI (Normalized Mutual Information): {nmi_hdb:.4f}\\\")\\n\",\n",
    "    \"    # print(f\\\"ARI (Adjusted Rand Index): {ari_hdb:.4f}\\\")\\n\",\n",
    "    \"    # print(f\\\"Liczba znalezionych klastrów: {n_clusters_hdb}\\\")\\n\",\n",
    "    \"    # print(f\\\"Liczba punktów noise: {n_noise}\\\\n\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return cluster_ids, kmeans, metrics\"\n",
    "   ],\n",
    "   \"id\": \"a095ad9ce048e195\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
