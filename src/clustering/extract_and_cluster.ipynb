    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def visualize_clusters(features, cluster_ids, labels, save_path):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Pokazanie klastrow w 2D (PCA)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pca = PCA(n_components=2, random_state=42)\\n\",\n",
    "    \"    features_2d = pca.fit_transform(features)\\n\",\n",
    "    \"    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # klastry k-means\\n\",\n",
    "    \"    scatter1 = ax1.scatter(features_2d[:, 0], features_2d[:, 1],\\n\",\n",
    "    \"                          c=cluster_ids, cmap='tab10', alpha=0.6, s=3)\\n\",\n",
    "    \"    ax1.set_title('K-means Clusters', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"    plt.colorbar(scatter1, ax=ax1, label='Cluster ID')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # etykeity z datasetu\\n\",\n",
    "    \"\\n\",\n",
    "    \"    scatter2 = ax2.scatter(features_2d[:, 0], features_2d[:, 1],\\n\",\n",
    "    \"                          c=labels, cmap='tab10', alpha=0.6, s=3)\\n\",\n",
    "    \"    ax2.set_title('True Labels', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"    plt.colorbar(scatter2, ax=ax2, label='Class ID')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.savefig(save_path, dpi=300, bbox_inches='tight')\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.close()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def visualize_clusters_tsne(features, cluster_labels, true_labels, save_path=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Wizualizacja klastrów za pomocą t-SNE\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    tsne = TSNE(n_components=2, random_state=42, perplexity=30)\\n\",\n",
    "    \"    features_2d = tsne.fit_transform(features)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(1, 2, figsize=(16, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Wizualizacja z przypisaniami z K-Means\\n\",\n",
    "    \"    scatter1 = axes[0].scatter(features_2d[:, 0], features_2d[:, 1],\\n\",\n",
    "    \"                               c=cluster_labels, cmap='tab10', s=5, alpha=0.6)\\n\",\n",
    "    \"    axes[0].set_title('K-Means Cluster Assignments')\\n\",\n",
    "    \"    axes[0].set_xlabel('t-SNE Component 1')\\n\",\n",
    "    \"    axes[0].set_ylabel('t-SNE Component 2')\\n\",\n",
    "    \"    plt.colorbar(scatter1, ax=axes[0])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Wizualizacja z prawdziwymi etykietami\\n\",\n",
    "    \"    scatter2 = axes[1].scatter(features_2d[:, 0], features_2d[:, 1],\\n\",\n",
    "    \"                               c=true_labels, cmap='tab10', s=5, alpha=0.6)\\n\",\n",
    "    \"    axes[1].set_title('True Class Labels')\\n\",\n",
    "    \"    axes[1].set_xlabel('t-SNE Component 1')\\n\",\n",
    "    \"    axes[1].set_ylabel('t-SNE Component 2')\\n\",\n",
    "    \"    plt.colorbar(scatter2, ax=axes[1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if save_path:\\n\",\n",
    "    \"        plt.savefig(save_path, dpi=300, bbox_inches='tight')\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"bdaf9f6816e64322\",\n",
