    "    \"# Wizualizacja klastrów\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-18T18:32:57.752027Z\",\n",
